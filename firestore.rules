rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "digitalsoutien@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+@.+');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.customerName is string && data.customerName.size() <= 100 &&
               data.phone is string && data.phone.size() <= 20 &&
               data.city is string && data.city.size() <= 50 &&
               data.address is string && data.address.size() <= 200 &&
               data.productId is string &&
               data.quantity is int && data.quantity > 0 &&
               data.status in ['pending', 'processing', 'delivered', 'cancelled', 'cancelled_by_customer', 'deleted_by_customer'] &&
               data.totalPrice is number;
      }

      function hasRequiredFields(data) {
        return data.keys().hasAll(['customerName', 'email', 'phone', 'city', 'address', 'productId', 'productName', 'quantity', 'deliveryMode', 'status', 'totalPrice', 'createdAt']);
      }

      allow create: if isValidOrder(incoming()) && 
                       hasRequiredFields(incoming()) &&
                       incoming().status == 'pending' &&
                       incoming().createdAt == request.time;
      
      allow get: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      
      allow update: if (isAdmin() && 
                        isValidOrder(incoming()) &&
                        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) || 
                         incoming().diff(existing()).affectedKeys().hasOnly(['customerName', 'phone', 'city', 'address', 'status', 'updatedAt'])) &&
                        (incoming().updatedAt == request.time)) ||
                       (isSignedIn() && 
                        resource.data.email == request.auth.token.email &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                        incoming().status in ['cancelled_by_customer', 'deleted_by_customer'] &&
                        incoming().updatedAt == request.time);
      
      allow delete: if isAdmin();
    }

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 200 &&
               data.description is string && data.description.size() <= 1000 &&
               data.price is number && data.price >= 0 &&
               (data.oldPrice == null || data.oldPrice is number) &&
               data.imageUrl is string &&
               (data.images == null || (data.images is list && data.images.size() <= 4)) &&
               data.stock is int &&
               data.isPromo is bool &&
               data.marketingPoints is list &&
               data.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // Admin profiles
    match /admins/{email} {
      allow read: if isAdmin();
      allow create, delete: if isSignedIn() && 
        request.auth.token.email.lower() == "digitalsoutien@gmail.com" && 
        email != "digitalsoutien@gmail.com";
    }
  }
}
